<%- include('partials/header') %>

  <main>
    <h1>
      <%= title %>
    </h1>

    <ul class="project-list">
      <% projects.forEach(project => { %>
        <li>
          <a href="/project/<%= project.project_id %>">
            <%= project.title %>
          </a>
        </li>
      <% }) %>
    </ul>
  </main>

  <%- include('partials/footer') %>
