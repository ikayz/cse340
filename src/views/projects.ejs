<%- include('partials/header') %>

  <main>
    <h1>
      <%= title %>
    </h1>
    <div class="card-container">
      <% projects.forEach(project=> { %>
        <div class="card">
          <div class="card-content">
            <p>
              <strong>
                <%= new Date(project.date).toLocaleDateString('en-GB', { day: 'numeric' , month: 'long' ,
                  year: 'numeric' }) %>
              </strong>:
              <a href="/project/<%= project.project_id %>">
                <%= project.title %>
              </a>
              (<a href="/organization/<%= project.organization_id %>">
                <%= project.organization_name %>
              </a>)
            </p>
          </div>
          <div class="card-logo">
            <img src="/images/<%= project.logo_filename %>" alt="<%= project.organization_name %> logo">
          </div>
        </div>
        <% }) %>
    </div>
    <div style="margin-top: 2rem; text-align: center;">
      <a href="/new-project" class="btn-submit" style="display: inline-block; width: auto; padding: 0.75rem 1.5rem;">Add a New Service Project</a>
    </div>
  </main>

  <%- include('partials/footer') %>
