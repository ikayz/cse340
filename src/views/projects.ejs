<%- include('partials/header') %>

  <main>
    <h1>
      <%= title %>
    </h1>
    <h2>Upcoming Service Projects</h2>
    <div class="card-container">
      <% projects.forEach(project=> { %>
        <div class="card">
          <div class="card-content">
            <p>
              <strong>
                <%= new Date(project.project_date).toLocaleDateString('en-GB', { day: 'numeric' , month: 'long' ,
                  year: 'numeric' }) %>
              </strong>:
              <%= project.title %> (<%= project.organization_name %>)
            </p>
          </div>
          <div class="card-logo">
            <img src="/images/<%= project.logo_filename %>" alt="<%= project.organization_name %> logo">
          </div>
        </div>
        <% }) %>
    </div>
  </main>

  <%- include('partials/footer') %>
