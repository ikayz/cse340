<%- include('partials/header') %>
  <main>
    <div class="form-wrapper">
      <div class="form-header">
        <h1>
          <%= title %>
        </h1>
        <p>Fill out the details below to create a new account.</p>
      </div>

      <form action="/register" method="POST" class="styled-form">
        <div class="form-group">
          <label for="name">Name</label>
          <input type="text" id="name" name="name" placeholder="e.g. Jane Doe" required maxlength="100" />
        </div>

        <div class="form-group">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" placeholder="jane.doe@example.com" required />
        </div>

        <div class="form-group">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" placeholder="At least 8 characters" required minlength="8" />
        </div>

        <button type="submit" class="btn-submit">Register</button>
      </form>
      
      <p style="text-align: center; margin-top: 1.5rem;">
        Already have an account? <a href="/login">Login here</a>
      </p>
    </div>
  </main>
<%- include('partials/footer') %>
