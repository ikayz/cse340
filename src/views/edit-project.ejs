<%- include('partials/header') %>
  <main>
    <div class="form-wrapper">
      <div class="form-header">
        <h1><%= title %></h1>
        <p>Edit the details below to update the service project.</p>
      </div>

      <form action="/edit-project/<%= projectDetails.project_id %>" method="POST" class="styled-form">
        <div class="form-group">
          <label for="organizationId">Organization</label>
          <select id="organizationId" name="organizationId" required>
            <option value="" disabled>Select an Organization</option>
            <% organizations.forEach(org => { %>
              <option value="<%= org.organization_id %>" <%= org.organization_id === projectDetails.organization_id ? 'selected' : '' %>>
                <%= org.name %>
              </option>
            <% }) %>
          </select>
        </div>

        <div class="form-group">
          <label for="title">Project Title</label>
          <input type="text" id="title" name="title" value="<%= projectDetails.title %>" required maxlength="150" />
        </div>

        <div class="form-group">
          <label for="description">Description</label>
          <textarea id="description" name="description" required maxlength="500"><%= projectDetails.description %></textarea>
        </div>

        <div class="form-group">
          <label for="location">Location</label>
          <input type="text" id="location" name="location" value="<%= projectDetails.location %>" required />
        </div>

        <div class="form-group">
          <label for="projectDate">Project Date</label>
          <input type="date" id="projectDate" name="projectDate" value="<%= projectDetails.formattedDate %>" required />
        </div>

        <button type="submit" class="btn-submit">Update Project</button>
      </form>
    </div>
  </main>
<%- include('partials/footer') %>
