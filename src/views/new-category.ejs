<%- include('partials/header') %>
  <main>
    <div class="form-wrapper">
      <div class="form-header">
        <h1><%= title %></h1>
        <p>Fill out the details below to add a new category.</p>
      </div>

      <form action="/new-category" method="POST" class="styled-form">
        <div class="form-group">
          <label for="name">Category Name</label>
          <input type="text" id="name" name="name" placeholder="e.g. Education" required maxlength="100" />
        </div>

        <button type="submit" class="btn-submit">Create Category</button>
      </form>
    </div>
  </main>
<%- include('partials/footer') %>
