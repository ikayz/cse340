<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= title %>
  </title>
  <link rel="stylesheet" href="/css/main.css">
</head>

<body>
  <nav>
    <div class="nav-container">
      <a href="/" class="logo">
        <img src="/images/cse340-service-network.png" alt="Service Network Logo">
      </a>
      <ul class="nav-links">
        <li><a href="/" class="<%= path === '/' ? 'active' : '' %>">Home</a></li>
        <li><a href="/organizations" class="<%= path === '/organizations' ? 'active' : '' %>">Organizations</a></li>
        <li><a href="/projects" class="<%= path === '/projects' ? 'active' : '' %>">Projects</a></li>
        <li><a href="/categories" class="<%= path === '/categories' ? 'active' : '' %>">Categories</a></li>
        <% if (isLoggedIn) { %>
          <li>
            <form action="/logout" method="POST" style="margin: 0;">
              <button type="submit" style="background: none; border: 0; padding: 0; color: inherit; cursor: pointer; font: inherit;">Logout</button>
            </form>
          </li>
        <% } else { %>
          <li><a href="/login" class="<%= path === '/login' ? 'active' : '' %>">Login</a></li>
          <li><a href="/register" class="<%= path === '/register' ? 'active' : '' %>">Register</a></li>
        <% } %>
      </ul>
      <button class="hamburger">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </div>
  </nav>

  <div id="toast-container" class="toast-container">
    <% const messages=flash(); %>
    <% Object.keys(messages).forEach(type=> { %>
      <% if (messages[type].length> 0) { %>
        <% messages[type].forEach(msg=> { %>
          <div class="toast-alert <%= type %>" role="alert">
            <div class="toast-content"><%= msg %></div>
            <button aria-label="Close" class="toast-close" onclick="this.parentElement.style.display='none';">&times;</button>
          </div>
        <% }); %>
      <% } %>
    <% }); %>
  </div>
