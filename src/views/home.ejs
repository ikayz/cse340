<%- include('partials/header') %>

<header class="hero">
</header>

<main>
  <div class="home-content">
    <h1><%= title %></h1>
    <h2>Welcome to the CSE 340 Service Network!</h2>
    <p>Our mission is to promote service across the world by connecting volunteers with service opportunities in their community.</p>
    <img src="/images/cse340-service-network.png" alt="CSE340 Service Network Logo" class="home-logo">
    <% if (isLoggedIn) { %>
      <div class="dashboard-access" style="margin-top: 2rem; text-align: center;">
        <a href="/dashboard" class="btn-dashboard" style="display: inline-block; padding: 0.8rem 1.5rem; background-color: #2c3e50; color: white; text-decoration: none; border-radius: 4px; font-weight: bold;">My Dashboard</a>
      </div>
    <% } %>
  </div>
</main>

<%- include('partials/footer') %>
