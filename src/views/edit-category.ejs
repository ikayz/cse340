<%- include('partials/header') %>
  <main>
    <div class="form-wrapper">
      <div class="form-header">
        <h1><%= title %></h1>
        <p>Edit the details below to update the category.</p>
      </div>

      <form action="/edit-category/<%= categoryDetails.category_id %>" method="POST" class="styled-form">
        <div class="form-group">
          <label for="name">Category Name</label>
          <input type="text" id="name" name="name" value="<%= categoryDetails.name %>" required maxlength="100" />
        </div>

        <button type="submit" class="btn-submit">Update Category</button>
      </form>
    </div>
  </main>
<%- include('partials/footer') %>
