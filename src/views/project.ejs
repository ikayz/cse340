<%- include('partials/header') %>

  <main>
    <h1>
      <%= title %>
    </h1>

    <h2>
      <%= projectDetails.title %>
    </h2>
    <p>
      <%= projectDetails.description %>
    </p>

    <p>
      <strong>Date:</strong>
      <%= new Date(projectDetails.date).toLocaleDateString('en-GB', { day: 'numeric' , month: 'long' , year: 'numeric'
        }) %><br>
        <strong>Location:</strong>
        <%= projectDetails.location %>
    </p>

    <p>Organization: <a href="/organization/<%= projectDetails.organization_id %>">
        <%= projectDetails.organization_name %>
      </a></p>

    <div class="categories">
      <strong>Categories:</strong>
      <% categories.forEach(category=> { %>
        <a href="/category/<%= category.category_id %>">
          <%= category.name %>
        </a>
        <% }) %>
          <% if (user && user.role_name==='admin' ) { %>
            <span class="edit-link">
              [ <a href="/assign-categories/<%= projectDetails.project_id %>">Edit Categories</a> ]
            </span>
            <% } %>
    </div>
    
    <div class="volunteer-action" style="margin-top: 2rem;">
      <% if (isLoggedIn) { %>
        <% if (isVolunteered) { %>
          <div style="padding: 1rem; border: 1px solid #c3e6cb; background-color: #d4edda; color: #155724; border-radius: 4px;">
            <p><strong>You are volunteering for this project!</strong></p>
            <a href="/unvolunteer/<%= projectDetails.project_id %>" class="btn-submit" style="background-color: #e74c3c; display: inline-block; width: auto; padding: 0.5rem 1rem; text-decoration: none; margin-top: 0.5rem;">Remove Volunteer</a>
          </div>
        <% } else { %>
          <a href="/volunteer/<%= projectDetails.project_id %>" class="btn-submit" style="display: inline-block; width: auto; padding: 0.8rem 1.5rem; text-decoration: none; font-weight: bold; background-color: #27ae60;">Volunteer for this Project</a>
        <% } %>
      <% } %>
    </div>

    <% if (user && user.role_name==='admin' ) { %>
      <div class="actions" style="margin-top: 2rem; border-top: 1px solid #ddd; padding-top: 1rem;">
        <a href="/edit-project/<%= projectDetails.project_id %>" class="btn-submit"
          style="display: inline-block; width: auto; padding: 0.5rem 1rem;">Edit Project</a>
      </div>
    <% } %>

  </main>

  <%- include('partials/footer') %>
