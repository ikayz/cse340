<%- include('partials/header') %>

  <main>
    <h1>
      <%= title %>
    </h1>
    <p>Here are a few of our partner organizations:</p>
    <div class="card-container">
      <% organizations.forEach(organization=> { %>
        <div class="card">
          <div class="card-logo">
            <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo">
          </div>
          <div class="card-content">
            <h3>
              <a href="/organization/<%= organization.organization_id %>">
                <%= organization.name %>
              </a>
            </h3>
            <p>
              <%= organization.contact_email %>
            </p>
          </div>
        </div>
        <% }) %>
    </div>
    <div style="margin-top: 2rem; text-align: center;">
      <a href="/new-organization" class="btn-submit" style="display: inline-block; width: auto; padding: 0.75rem 1.5rem;">Add a new organization</a>
    </div>
  </main>

  <%- include('partials/footer') %>
